# ==============================================================================
# RiskShield AI — Environment Configuration Template
# All secrets and environment-specific variables must be defined here.
# Copy this file to `.env` for local execution.
# NEVER commit the actual `.env` file containing secrets to version control.
# ==============================================================================

# --- Global Environment ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Spring Boot Backend Configuration ---
SERVER_PORT=8080
BACKEND_BASE_URL=http://localhost:8080
SPRING_PROFILES_ACTIVE=dev

# --- Database (PostgreSQL 16) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=riskshield_db
POSTGRES_USER=riskshield_user
POSTGRES_PASSWORD=riskshield_secure_dev_password
SPRING_DATASOURCE_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
SPRING_DATASOURCE_USERNAME=${POSTGRES_USER}
SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD}
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=true

# --- Distributed Cache & Velocity State (Redis 7) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
SPRING_DATA_REDIS_HOST=${REDIS_HOST}
SPRING_DATA_REDIS_PORT=${REDIS_PORT}

# --- Event Messaging (Apache Kafka) ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_GROUP_ID=riskshield-backend-group
KAFKA_TOPIC_PAYMENT_EVENTS=riskshield.payment.events
KAFKA_TOPIC_FRAUD_ALERTS=riskshield.fraud.alerts
KAFKA_TOPIC_SPIKE_NOTIFICATIONS=riskshield.spike.notifications

# --- Python ML Service (FastAPI) ---
ML_SERVICE_PORT=8000
ML_SERVICE_HOST=ml-service
ML_SERVICE_URL=http://${ML_SERVICE_HOST}:${ML_SERVICE_PORT}
ML_MODEL_VERSION=v1.0.0-xgb-prototype
ML_INFERENCE_TIMEOUT_MS=50
ML_CIRCUIT_BREAKER_FAILURE_RATE_THRESHOLD=50
ML_CIRCUIT_BREAKER_WAIT_DURATION_SECONDS=10

# --- React Frontend Configuration ---
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_ML_API_BASE_URL=http://localhost:8000/api/v1
VITE_ENABLE_MOCK_STREAM=false

# --- Razorpay Test Mode Credentials ---
# CRITICAL: Always use Test Mode API Keys (starts with 'rzp_test_').
# Never insert production keys or commit secrets to Git.
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_test_webhook_secret_for_signature

# --- AI Investigation Assistant (Google Gemini LLM) ---
# Used strictly for read-only investigation summarization & explanations (never for direct decisions)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.2

# --- Data Generator Simulator ---
SIMULATOR_TRANSACTIONS_PER_SECOND=2
SIMULATOR_FRAUD_RATIO=0.08
SIMULATOR_BURST_MODE=false
